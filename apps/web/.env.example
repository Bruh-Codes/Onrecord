# Copy to .env.local (gitignored) for local `bun dev`. See the "Required env"
# block in README.md and the root .env.example.

BETTER_AUTH_SECRET=dev-only-secret-change-me-32chars
BETTER_AUTH_URL=http://localhost:3000
# Server-only: used by Better Auth route handlers and never exposed to the browser.
DATABASE_URL=postgresql://sme:sme@localhost:5432/sme

# Browser base URL for the apps/api backend. Local dev default; point at the
# deployed Railway API when running against the production backend:
#   NEXT_PUBLIC_BACKEND_URL=https://sme-project-production-9437.up.railway.app
NEXT_PUBLIC_BACKEND_URL=/backend
API_BACKEND_ORIGIN=http://localhost:8000
