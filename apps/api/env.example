# Copy to apps/api/.env (not committed). See README.md for setup.

DATABASE_URL=postgresql+asyncpg://sme:sme@localhost:5432/sme
DATABASE_URL_SYNC=postgresql+psycopg://sme:sme@localhost:5432/sme
REDIS_URL=redis://localhost:6379/0

BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:3000

STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=sme-documents
STORAGE_REGION=us-east-1

# --- LLM (pipeline + optional semantic passes) ---
# openai (default) or groq
LLM_PROVIDER=groq
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional override of provider base URL (usually leave empty)
LLM_BASE_URL=
# Worker semantic mapping / classification when LLM_PROVIDER matches
FINANCIAL_MAPPING_MODEL=gpt-5.6-luna

# --- Ona (owner assistant, POST .../agent/messages) ---
# Defaults to FINANCIAL_MAPPING_MODEL when unset. Production Groq example:
#   ONA_MODEL=openai/gpt-oss-120b
ONA_MODEL=openai/gpt-oss-120b
ONA_MAX_QUESTIONS_PER_HOUR=20

# Groq has no built-in web browsing; Ona runs server-side search before the model call.
ONA_WEB_SEARCH_ENABLED=true
ONA_MAX_WEB_RESULTS=5
# Set at least one for reliable web answers in production (recommended: Tavily):
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

CORS_ALLOW_ORIGINS=http://localhost:3000
