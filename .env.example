
# Any 32+ char random string. The default in docker-compose.yml is fine for
# local dev only — never reuse it anywhere real.
BETTER_AUTH_SECRET=dev-only-secret-change-me-32chars
BETTER_AUTH_URL=http://localhost:3000

# --- Web (apps/web) ---
DATABASE_URL=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Password-reset emails (Better Auth sendResetPassword -> Resend). Without the
# key the reset link is logged to the server console instead (local dev only).
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Onrecord <no-reply@your-domain.com>

# --- API / worker (apps/api) — also set on Railway for api + worker services ---
# Full list and comments: apps/api/env.example

# LLM_PROVIDER=openai
# OPENAI_API_KEY=
LLM_PROVIDER=groq
GROQ_API_KEY=

FINANCIAL_MAPPING_MODEL=gpt-5.6-luna

# Ona assistant (Groq GPT-OSS 120B is a common production choice)
ONA_MODEL=openai/gpt-oss-120b
ONA_MAX_QUESTIONS_PER_HOUR=20
ONA_WEB_SEARCH_ENABLED=true
ONA_MAX_WEB_RESULTS=5
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
