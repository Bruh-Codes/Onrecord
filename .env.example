
# Any 32+ char random string. The default in docker-compose.yml is fine for
# local dev only — never reuse it anywhere real.
BETTER_AUTH_SECRET=dev-only-secret-change-me-32chars
BETTER_AUTH_URL=http://localhost:3000

DATABASE_URL=

NEXT_PUBLIC_BACKEND_URL=backend_url
# Web → API base the browser calls. The compose default is fine for local
# dev. When the web runs on Vercel against the deployed Railway API, set:
#   NEXT_PUBLIC_BACKEND_URL=https://sme-project-production-9437.up.railway.app

# Password-reset emails (Better Auth sendResetPassword -> Resend). Without the
# key the reset link is logged to the server console instead (local dev only).
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Onrecord <no-reply@your-domain.com>
